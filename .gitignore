# Deny by default: only explicitly reviewed release documentation is tracked.
*
!.gitignore
!README.md
!THIRD-PARTY-NOTICES.txt
!DEPENDENCIES.json
!SOURCE-SCOPE.md
!LICENSE-REVIEW.md
!source/
!source/*.cs
!source/*.xaml
!source/*.csproj
!source/*.appxmanifest
!source/SteamFiles.json
!source/LanguagePacks.json
!source/WifiTransfer.html
!source/Properties/
!source/Properties/*.cs
!source/Properties/*.xml
!licenses/
!licenses/*.txt
!asset-preparation/
!asset-preparation/*.cs
!asset-preparation/*.cpp
!asset-preparation/*.vcxproj
!asset-preparation/*.ps1
!asset-preparation/*.md
!asset-preparation/*.txt
!asset-preparation/recipes/
!asset-preparation/recipes/*.tsv
!asset-preparation/licenses/
!asset-preparation/licenses/*.txt
!build/
!build/build-launcher.ps1
!build/make-icons.ps1
!release/
!release/SOURCE-INPUTS.json
!release/STEAMKIT-SOURCE.json
!release/STATUS.md
!release/REBUILD-FROM-SOURCE.md
!release/REDISTRIBUTION-REVIEW.md

!source/SteamTransfer/
!source/SteamTransfer/*.cs


!docs/
!docs/*.md
!docs/images/
!docs/images/banner.svg
# Historical reports are preserved outside the working tree.
release/LICENSE-CLARIFICATION-DRAFT.md
release/PACKAGE-INVENTORY-0.5.0.0.json
release/STEAMKIT-MIGRATION.md
release/STEAMKIT-VALIDATION.json
asset-preparation/*Tests.cs
