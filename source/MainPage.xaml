<Page x:Class="SpiderManInstaller.MainPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#0D1016" RequestedTheme="Dark" XYFocusKeyboardNavigation="Enabled">
 <Page.Resources>
  <Style TargetType="Button"><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="16,9"/><Setter Property="MinHeight" Value="36"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Background" Value="#292F3C"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EDF0F5"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="14"/></Style>
  <Style x:Key="Note" TargetType="TextBlock"><Setter Property="Foreground" Value="#A1ABBC"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#191E28"/><Setter Property="Padding" Value="16"/><Setter Property="CornerRadius" Value="8"/></Style>
  <Style x:Key="Method" TargetType="Button"><Setter Property="Background" Value="#1A202A"/><Setter Property="BorderBrush" Value="#323A49"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="16,12"/></Style>
  <Style TargetType="PivotHeaderItem"><Setter Property="FontSize" Value="17"/><Setter Property="Padding" Value="0,8,24,8"/></Style>
 </Page.Resources>
 <Grid x:Name="LayoutRoot" Margin="32,18,32,16" MaxWidth="1400">
  <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="80"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Top">
    <Border Background="#D22E49" CornerRadius="5" Width="34" Height="34"><TextBlock Text="US" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/></Border>
    <StackPanel><TextBlock Text="UWP Spider Launcher" FontSize="20" FontWeight="Bold" CharacterSpacing="100"/><TextBlock Text="UNOFFICIAL GAME LAUNCHER" Foreground="#929CAF" FontSize="10" CharacterSpacing="120"/></StackPanel>
   </StackPanel>
   <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="XBOX DEVELOPER MODE" Foreground="#A4B0C2" FontSize="11" CharacterSpacing="90"/>
  </Grid>
  <Pivot Grid.Row="1" x:Name="MainTabs" Margin="0" Padding="0">
   <PivotItem Header="Home" Margin="0,4,0,6">
    <Grid ColumnSpacing="18">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="88"/><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
      <TextBlock Text="Everything in one place." FontSize="24" FontWeight="SemiBold"/>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12">
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Spacing="5"><TextBlock Text="Marvel’s Spider-Man Remastered" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="PreparationStatus" Text="Checking your game…" Style="{StaticResource Note}" MaxLines="2" TextTrimming="CharacterEllipsis"/></StackPanel>
        <Button Grid.Column="1" x:Name="PlayButton" Content="▶  Play" Click="Play_Click" IsEnabled="False" Background="#D52F49" Foreground="White" VerticalAlignment="Center"/>
       </Grid>
      </Border>
      <TextBlock Grid.Row="2" Text="INSTALL FROM" FontSize="10" Foreground="#8D9BB0" CharacterSpacing="110" VerticalAlignment="Center"/>
      <Grid Grid.Row="3" ColumnSpacing="10" MinHeight="86">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Button x:Name="SteamTile" Style="{StaticResource Method}" Click="InstallMethod_Click" Tag="Steam"><StackPanel Spacing="7"><FontIcon Glyph="&#xE896;" FontSize="22" Foreground="#FF7187" HorizontalAlignment="Left"/><TextBlock Text="Steam" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Download your copy" Style="{StaticResource Note}"/></StackPanel></Button>
       <Button x:Name="UsbTile" Grid.Column="1" Style="{StaticResource Method}" Click="InstallMethod_Click" Tag="Usb"><StackPanel Spacing="7"><FontIcon Glyph="&#xE88E;" FontSize="22" HorizontalAlignment="Left"/><TextBlock Text="USB drive" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Import game files" Style="{StaticResource Note}"/></StackPanel></Button>
       <Button x:Name="WifiTile" Grid.Column="2" Style="{StaticResource Method}" Click="InstallMethod_Click" Tag="Wifi"><StackPanel Spacing="7"><FontIcon Glyph="&#xE701;" FontSize="22" HorizontalAlignment="Left"/><TextBlock Text="Wi-Fi" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Transfer from a PC" Style="{StaticResource Note}"/></StackPanel></Button>
      </Grid>
      <Grid Grid.Row="4" VerticalAlignment="Bottom"><TextBlock x:Name="HomeStorage" Style="{StaticResource Note}" VerticalAlignment="Center"/><Button Content="Manage files" Click="Manage_Click" HorizontalAlignment="Right" FontSize="12" Padding="12,6" MinHeight="30"/></Grid>
     </Grid>
     <Border Grid.Column="1" CornerRadius="8" Background="#251925" Padding="0" IsHitTestVisible="False">
      <Grid>
       <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#642737" Offset="0"/><GradientStop Color="#151D2F" Offset="1"/></LinearGradientBrush></Grid.Background>
       <Viewbox Stretch="Uniform"><Canvas Width="220" Height="260">
        <Path Stroke="#646776" StrokeThickness="1" Opacity="0.6" Data="M0,230 L190,0 M0,100 L190,0 M90,260 L190,0 M220,240 L190,0 M0,15 L190,0 M80,9 Q83,72 117,93 Q157,122 205,97 M35,12 Q37,110 80,150 Q130,206 217,173 M0,34 Q7,154 45,202 Q103,267 220,239"/>
        <Path Fill="#0D1523" Opacity="0.9" Data="M0,260 L0,210 18,210 18,170 41,170 41,199 60,199 60,146 88,146 88,205 106,205 106,164 125,164 125,189 143,189 143,133 174,133 174,173 191,173 191,203 220,203 220,260 Z"/>
       </Canvas></Viewbox>
       <StackPanel VerticalAlignment="Bottom" Margin="18,0,18,20" Spacing="5"><TextBlock Text="NEW YORK" FontSize="10" CharacterSpacing="220" Foreground="#D395A4"/><TextBlock Text="Your next adventure." FontSize="24" FontWeight="SemiBold"/></StackPanel>
      </Grid>
     </Border>
    </Grid>
   </PivotItem>
   <PivotItem Header="Install" Margin="0,4,0,6">
    <Grid RowSpacing="10">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Steam" Click="InstallMethod_Click" Tag="Steam"/><Button Content="USB drive" Click="InstallMethod_Click" Tag="Usb"/><Button Content="Wi-Fi" Click="InstallMethod_Click" Tag="Wifi"/></StackPanel>
     <Border Grid.Row="1" Style="{StaticResource Card}">
      <Grid>
       <Grid x:Name="SteamPanel" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="176"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="9"><TextBlock Text="Download from Steam" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Sign in with the Steam mobile app to download your owned game directly to Xbox." Style="{StaticResource Note}"/>
         <Button x:Name="SteamButton" Content="Sign in and download" Click="Steam_Click" Background="#D52F49" Foreground="White" HorizontalAlignment="Left"/>
         <TextBlock x:Name="SteamInfo" Text="Supported version selected automatically. No password is stored." Foreground="#86D4DF" FontSize="12" MaxLines="3" TextTrimming="CharacterEllipsis"/>
        </StackPanel><Image Grid.Column="1" x:Name="SteamQr" Width="176" Height="176" VerticalAlignment="Center" Visibility="Collapsed"/>
       </Grid>
       <StackPanel x:Name="UsbPanel" Visibility="Collapsed" Spacing="8"><TextBlock Text="Import from USB" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Connect a USB drive with the supported game folder or ZIP. All included supported voice packs are copied." Style="{StaticResource Note}"/><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="ScanButton" Content="Find files" Click="Scan_Click"/><ComboBox Grid.Column="1" x:Name="ArchiveList" PlaceholderText="Select a game folder or ZIP" HorizontalAlignment="Stretch" FontSize="14" AutomationProperties.Name="Available game folders and ZIPs"/></Grid><Button x:Name="UsbImportButton" Content="Import selected files" Click="Import_Click" HorizontalAlignment="Left"/></StackPanel>
       <Grid x:Name="WifiPanel" Visibility="Collapsed" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="148"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="4"><TextBlock Text="Transfer over Wi-Fi" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Choose your game folder on a PC. No ZIP needed." Style="{StaticResource Note}"/>
         <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="WifiButton" Content="Start receiver" Click="Wifi_Click"/><Button x:Name="IncomingButton" Content="Import received ZIP" Click="Incoming_Click" FontSize="12" Padding="12,8"/></StackPanel>
         <TextBlock x:Name="WifiAddress" FontSize="18" FontWeight="SemiBold" Foreground="#86D4DF" IsTextSelectionEnabled="True"/>
         <TextBlock x:Name="WifiPairing" FontSize="16" IsTextSelectionEnabled="True"/>
         <TextBlock x:Name="WifiInfo" Foreground="#B4BED0" FontSize="12" MaxLines="2" TextTrimming="CharacterEllipsis" Text="Start the receiver to show the address and pairing code."/>
        </StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"><Image x:Name="WifiQr" Width="148" Height="148" Visibility="Collapsed"/><TextBlock x:Name="WifiQrHint" Text="Scan to open and pair" FontSize="11" HorizontalAlignment="Center" Visibility="Collapsed"/></StackPanel>
       </Grid>
      </Grid>
     </Border>
     <Border Grid.Row="2" x:Name="PrepareCard" Style="{StaticResource Card}" Padding="12,8">
      <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox x:Name="ImportList" PlaceholderText="Choose an imported copy" HorizontalAlignment="Stretch" FontSize="13" AutomationProperties.Name="Imported game"/>
       <Button Grid.Column="1" x:Name="PrepareButton" Content="Prepare game" Click="Prepare_Click"/><Button Grid.Column="2" Content="Refresh" Click="Refresh_Click"/>
      </Grid>
     </Border>
    </Grid>
   </PivotItem>
   <PivotItem Header="Storage" Margin="0,4,0,6">
    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}"><StackPanel Spacing="14"><TextBlock Text="Xbox storage" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="DestinationInfo" FontSize="15" Foreground="#86D4DF"/><Button Content="Refresh storage" Click="StorageRefresh_Click" HorizontalAlignment="Left"/></StackPanel></Border>
     <Border Grid.Column="1" Style="{StaticResource Card}" Background="#241C27"><StackPanel Spacing="12"><TextBlock Text="Remove game files" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Free space used by the prepared game. Import and prepare your copy again to play." Style="{StaticResource Note}"/><TextBlock Text="Keeps saves, the runtime app and your original files. Close the game first." FontSize="13"/><Button x:Name="DeleteGameButton" Content="Review deletion…" Click="DeleteGame_Click" HorizontalAlignment="Left" Background="#542839"/><TextBlock x:Name="CleanupStatus" FontSize="12" Foreground="#EEC0CA" MaxLines="3" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
    </Grid>
   </PivotItem>
   <PivotItem Header="Settings" Margin="0,4,0,6">
    <Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Download connections" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="More workers can improve speed when the connection and drive can keep up." Style="{StaticResource Note}"/>
     <ComboBox x:Name="DownloadWorkers" SelectedIndex="1" SelectionChanged="Workers_Changed" Width="260" HorizontalAlignment="Left" FontSize="14" AutomationProperties.Name="Download workers"><ComboBoxItem Content="2 workers — conservative"/><ComboBoxItem Content="4 workers — default"/><ComboBoxItem Content="8 workers — faster network"/></ComboBox>
     <TextBlock Text="Applies to the next download. Actual speed depends on Steam, your network and Xbox storage." Style="{StaticResource Note}"/>
     <TextBlock Text="Stopping a download keeps partial files. Sign in again to verify and resume them." Style="{StaticResource Note}"/>
    </StackPanel></Border>
   </PivotItem>
  </Pivot>
  <Border Grid.Row="2" BorderBrush="#303746" BorderThickness="0,1,0,0" Padding="0,10,0,0">
   <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Spacing="5">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="Choose Play, or install your game." FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Grid.Column="1" x:Name="TransferSize" Foreground="#B4BED0" FontSize="12" Margin="12,0,0,0"/></Grid>
     <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Height="5" Foreground="#EC3C58"/>
     <Grid><TextBlock x:Name="TransferStats" Text="A  Select  ·  D-pad  Navigate  ·  LB / RB  Tabs" Foreground="#93A0B4" FontSize="11"/><TextBlock x:Name="TransferPercent" HorizontalAlignment="Right" Foreground="#CCD3DF" FontSize="11"/></Grid>
    </StackPanel>
    <Button Grid.Column="1" x:Name="CancelButton" Visibility="Collapsed" Content="Stop transfer" Click="Cancel_Click" VerticalAlignment="Top" FontSize="12" Padding="12,8"/>
   </Grid>
  </Border>
 </Grid>
</Page>
